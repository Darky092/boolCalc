<Window x:Class="laba_6.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:laba_6"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800">
    <Grid>
        <Button x:Name="back" Content="back" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="47" Width="74" Click="back_Click"/>
        <Button x:Name="upload" Content="upload ur fls" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Height="47" Width="444" Click="upload_Click"/>
        <TextBox x:Name="filetext" HorizontalAlignment="Center" Margin="0,62,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="650" Height="108"/>
        <Label Content="ваш файл" HorizontalAlignment="Left" Margin="107,39,0,0" VerticalAlignment="Top" Width="66"/>
        <Grid x:Name="gridTwo" Margin="140,170,136,85" Background="AliceBlue" Visibility="Hidden">
            <Button x:Name="enter" Margin="124,100,139,29" Content="enter" Click="enter_Click"></Button>
            <TextBox x:Name="Booleans" HorizontalAlignment="Center" Margin="0,34,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="356" Height="34"/>
            <Label Content="Введи значение переменных через запятую" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Top" Width="356"/>
            <TextBlock x:Name="quest" HorizontalAlignment="Center" Margin="0,73,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="22" Width="356"/>
            <Label Content="выражение" HorizontalAlignment="Left" Margin="0,68,0,0" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock x:Name="filePathBox" HorizontalAlignment="Center" Margin="0,363,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="39" Width="340"/>
        <Label Content="путь к файлу" HorizontalAlignment="Left" Margin="92,365,0,0" VerticalAlignment="Top" Width="81"/>

    </Grid>

</Window>
